{
  "name": "agenthub",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter agenthub-desktop dev",
    "dev:web": "pnpm --filter agenthub-web dev",
    "dev:mobile-rn": "pnpm --filter agenthub-mobile-rn dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:web": "pnpm --filter agenthub-web test:e2e",
    "test:e2e:desktop": "pnpm --filter agenthub-desktop test:e2e",
    "test:smoke:matrix": "python ../scripts/smoke/verify-e2e-smoke-matrix.py -RepoRoot ..",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
    "test:css-syntax": "node scripts/verify-design-css-syntax.mjs",
    "test:css-syntax:self-test": "node scripts/verify-design-css-syntax.mjs --self-test",
    "test:e2e:geometry-smoke": "pnpm --filter agenthub-web test:e2e:geometry-smoke && pnpm --filter agenthub-desktop test:e2e:geometry-smoke"
  },
  "pnpm": {
    "hoistedDependencies": [
      "react",
      "react-dom",
      "typescript"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/prismjs": "^1.26.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^16.21.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@lobehub/icons": "^5.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "i18next": "^26.3.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  }
}
