{
  "name": "agenthub-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:smoke": "playwright test --config playwright.config.ts --project=chromium smoke.spec.ts",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "test:e2e:chat-flow": "playwright test --config playwright.config.ts --project=chromium chat-flow-contract.spec.ts",
    "test:e2e:stubbed-hub": "playwright test --config playwright.config.ts --project=chromium chat-flow-contract.spec.ts web-stubbed-hub-replay-smoke.spec.ts web-stubbed-hub-fenced-code.spec.ts task-contract.spec.ts",
    "test:e2e:approved-real-stub": "pnpm test:e2e:stubbed-hub",
    "test:visual:chat-flow": "node scripts/manual-chat-flow-check.mjs",
    "visual:qa:shell": "node scripts/visual-qa-shell.mjs",
    "visual:qa:shell:2x": "node scripts/visual-qa-shell-2x.mjs",
    "visual:qa:chat": "node scripts/visual-qa-chat.mjs",
    "assert:visual:qa:shell": "node scripts/assert-visual-qa-shell.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e:geometry-smoke": "playwright test --config playwright.config.ts --project=chromium geometry-smoke.spec.ts"
  },
  "dependencies": {
    "@agenthub/shared": "workspace:*",
    "@agenthub/workbench": "workspace:*",
    "@lobehub/icons": "^5.10.0",
    "@tanstack/react-query": "^5.101.4",
    "i18next": "^26.3.6",
    "lucide-react": "^1.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "virtua": "^0.50.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
