{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "AgentHub Desktop",
  "version": "0.6.1",
  "identifier": "com.agenthub.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "AgentHub Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; frame-src 'none'; object-src 'none'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* https://*.vectorcontrol.tech wss://*.vectorcontrol.tech; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.vectorcontrol.tech https://avatars.githubusercontent.com; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/agenthub-edge"
    ],
    "icon": [
      "icons/agenthub-icon-rounded-32.png",
      "icons/agenthub-icon-rounded-128.png",
      "icons/agenthub-icon-rounded-256.png",
      "icons/agenthub-icon-rounded.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true,
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/agenthub-icon-rounded.ico"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/TokenDanceLab/AgentHub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNTdCQkU3MjRFRDUwNjEKUldSaFVPMGs1N3RYZkZFODM3VkE4R0pKU01BQjU0MlRPdzNiWVRQVi9nV0N5ak5SQ25uK1AxNXAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
