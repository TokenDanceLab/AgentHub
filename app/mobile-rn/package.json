{
  "name": "agenthub-mobile-rn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:web": "expo start --web --port 5177",
    "mock:hub": "node scripts/mock-hub.mjs",
    "mock:hub:check": "node scripts/mock-hub.mjs --check",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm --dir .. exec eslint mobile-rn/src",
    "doctor": "expo-doctor",
    "native:check": "node scripts/native-readiness.mjs",
    "verify:brand": "node scripts/verify-brand-assets.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "visual:qa": "node scripts/visual-qa.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm verify:brand && pnpm verify:boundaries && pnpm test",
    "verify:qa": "pnpm verify && pnpm run doctor && pnpm run native:check && pnpm run mock:hub:check && pnpm visual:qa"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.14",
    "expo": "56.0.9",
    "expo-auth-session": "56.0.13",
    "expo-constants": "56.0.17",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-image-picker": "~56.0.16",
    "expo-linking": "56.0.13",
    "expo-localization": "~56.0.6",
    "expo-notifications": "56.0.16",
    "expo-secure-store": "56.0.4",
    "expo-status-bar": "56.0.4",
    "expo-web-browser": "56.0.5",
    "lucide-react-native": "^0.560.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.1",
    "expo-doctor": "^1.18.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
