root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.sh]
indent_style = tab
