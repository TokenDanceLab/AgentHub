# ══════════════════════════════════════════════════════════════════════════════
# WARNING: This is an EXAMPLE file — ALL credentials below are placeholders.
# NEVER commit real secrets to this file.  Copy to .env and fill in real values.
# .env is gitignored; this file is NOT.
# ══════════════════════════════════════════════════════════════════════════════

# Hub Server dev environment — copy to .env and customize
AGENTHUB_DB_PASSWORD=
AGENTHUB_JWT_SECRET=
AGENTHUB_DB_HOST=localhost
AGENTHUB_DB_PORT=5432
# AGENTHUB_DB_SSLMODE=disable  # disable | require | verify-ca | verify-full
AGENTHUB_DB_APPLICATION_NAME=agenthub
AGENTHUB_DB_MAX_OPEN_CONNS=20
AGENTHUB_DB_MAX_IDLE_CONNS=10
AGENTHUB_DB_CONN_MAX_LIFETIME=30m
AGENTHUB_DB_CONN_MAX_IDLE_TIME=5m
AGENTHUB_REDIS_HOST=localhost
AGENTHUB_REDIS_PORT=6379

# ── AgentTeam resource guardrails ─────────
AGENTHUB_AGENT_TEAM_MAX_DELEGATION_DEPTH=3
AGENTHUB_AGENT_TEAM_MAX_ACTIVE_SUBAGENTS_PER_RUN=5
AGENTHUB_AGENT_TEAM_MAX_ROUTE_REPEATS=3
AGENTHUB_AGENT_TEAM_MAX_TASKS_PER_TEAM_RUN=20
AGENTHUB_AGENT_TEAM_ASSIGNMENT_TIMEOUT=30m
AGENTHUB_AGENT_TEAM_MAX_TEAM_RUN_BUDGET_TOKENS=200000
AGENTHUB_AGENT_TEAM_MAX_TEAM_RUN_BUDGET_USAGE_PCT=95

# ── TokenDance Account OIDC ─────────────────
# Register a confidential AgentHub client in Account. Hub consumes only the
# public OIDC discovery/authorize/token/userinfo/JWKS endpoints; do not configure
# internal Account admin, database, or private service URLs.
#
# Exact redirect URIs:
#   Desktop: http://127.0.0.1:53682/callback
#   Web dev: http://localhost:5174/workbench/auth/account/callback
#            http://127.0.0.1:5174/workbench/auth/account/callback
#            root-base variants under /auth/account/callback
AGENTHUB_ACCOUNT_OIDC_ISSUER_URL=
AGENTHUB_ACCOUNT_OIDC_CLIENT_ID=
# Fill this from the Account client registration output; never commit it:
AGENTHUB_ACCOUNT_OIDC_CLIENT_SECRET=
AGENTHUB_ACCOUNT_OIDC_REDIRECT_URI=http://127.0.0.1:53682/callback
AGENTHUB_ACCOUNT_OIDC_ALLOWED_REDIRECT_URIS=http://localhost:5174/auth/account/callback,http://127.0.0.1:5174/auth/account/callback,http://localhost:5174/workbench/auth/account/callback,http://127.0.0.1:5174/workbench/auth/account/callback
# AGENTHUB_ACCOUNT_OIDC_HTTP_TIMEOUT=10s
# AGENTHUB_ACCOUNT_OIDC_MAX_RESPONSE_BODY_BYTES=65536
