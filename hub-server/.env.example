# Hub Server dev environment — copy to .env and customize
AGENTHUB_DB_PASSWORD=dev_password
AGENTHUB_JWT_SECRET=dev-secret-change-in-production-use-env-override
AGENTHUB_DB_HOST=localhost
AGENTHUB_DB_PORT=5432
AGENTHUB_REDIS_HOST=localhost
AGENTHUB_REDIS_PORT=6379

# ── AgentTeam resource guardrails ─────────
AGENTHUB_AGENT_TEAM_MAX_DELEGATION_DEPTH=3
AGENTHUB_AGENT_TEAM_MAX_ACTIVE_SUBAGENTS_PER_RUN=5
AGENTHUB_AGENT_TEAM_MAX_ROUTE_REPEATS=3
AGENTHUB_AGENT_TEAM_MAX_TASKS_PER_TEAM_RUN=20
AGENTHUB_AGENT_TEAM_ASSIGNMENT_TIMEOUT=30m
AGENTHUB_AGENT_TEAM_MAX_TEAM_RUN_BUDGET_TOKENS=200000
AGENTHUB_AGENT_TEAM_MAX_TEAM_RUN_BUDGET_USAGE_PCT=95

# ── TokenDance ID OIDC ─────────────────────
# See scripts/setup-tokendance-oidc.sh for automated setup.
#
# Steps to get real credentials:
# 1. Start TokenDance ID:  cd ../tokendance-id && go run ./cmd/tokendance-id
# 2. Run setup script:     bash scripts/setup-tokendance-oidc.sh
#    OR manually:
#    a. Login to TokenDance ID at http://localhost:3000
#    b. Create API key at /api/keys
#    c. Create OAuth client at /api/clients with name "AgentHub Desktop"
#       redirect_uris: ["http://127.0.0.1/callback", "http://localhost:5174/auth/tokendance/callback"]
#    d. Save the returned client_id and client_secret below
# 3. If TokenDance ID is NOT running, use the seed SQL:
#    sqlite3 ../tokendance-id/data/tokendance.db < scripts/seed-tokendance-client.sql
#    The seed uses client_id=agenthub-desktop with secret=agenthub-dev-secret-change-me

AGENTHUB_TOKENDANCE_ID_ISSUER_URL=http://localhost:3000
# AGENTHUB_TOKENDANCE_ID_JWKS_URI=           ← auto-derived from issuer_url + /oidc/jwks
AGENTHUB_TOKENDANCE_ID_CLIENT_ID=agenthub-desktop
AGENTHUB_TOKENDANCE_ID_CLIENT_SECRET=        ← fill in from setup script output (DO NOT COMMIT)
AGENTHUB_TOKENDANCE_ID_REDIRECT_URI=http://127.0.0.1/callback
AGENTHUB_TOKENDANCE_ID_ALLOWED_REDIRECT_URIS=http://127.0.0.1/callback,http://localhost:5174/auth/tokendance/callback
