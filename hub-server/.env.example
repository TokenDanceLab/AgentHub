# Hub Server dev environment — copy to .env and customize
AGENTHUB_DB_PASSWORD=dev_password
AGENTHUB_JWT_SECRET=dev-secret-change-in-production-use-env-override
AGENTHUB_DB_HOST=localhost
AGENTHUB_DB_PORT=5432
AGENTHUB_REDIS_HOST=localhost
AGENTHUB_REDIS_PORT=6379

# ── TokenDance ID OIDC ─────────────────────
AGENTHUB_TOKENDANCE_ISSUER_URL=https://id.vectorcontrol.tech
# AGENTHUB_TOKENDANCE_JWKS_URI=             ← derived from issuer/.well-known/jwks.json when empty
AGENTHUB_TOKENDANCE_CLIENT_ID=agenthub-desktop
# AGENTHUB_TOKENDANCE_CLIENT_SECRET=        ← fill in the real secret from TokenDance ID admin
AGENTHUB_TOKENDANCE_REDIRECT_URI=http://127.0.0.1:0/callback
