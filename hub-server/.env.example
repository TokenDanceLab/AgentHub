# Hub Server dev environment — copy to .env and customize
AGENTHUB_DB_PASSWORD=dev_password
AGENTHUB_JWT_SECRET=dev-secret-change-in-production-use-env-override
AGENTHUB_DB_HOST=localhost
AGENTHUB_DB_PORT=5432
AGENTHUB_REDIS_HOST=localhost
AGENTHUB_REDIS_PORT=6379

# ── TokenDance ID OIDC ─────────────────────
# AGENTHUB_TOKENDANCE_ID_ISSUER_URL=https://id.vectorcontrol.tech
# AGENTHUB_TOKENDANCE_ID_CLIENT_ID=your-client-id
# AGENTHUB_TOKENDANCE_ID_CLIENT_SECRET=your-client-secret
# AGENTHUB_TOKENDANCE_ID_REDIRECT_URI=http://localhost:8080/client/auth/oidc/callback
