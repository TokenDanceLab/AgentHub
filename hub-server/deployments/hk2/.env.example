# ──────────────────────────────────────────────
# AgentHub Hub Server — hk2 Production Environment Template
# ──────────────────────────────────────────────
# Copy to .env.hk2 and fill in real values:
#   cp .env.example .env.hk2
#
# IMPORTANT: This file contains secrets. Never commit to version control.
# Production secrets should be stored in:
#   <SECRETS_DIR>/agenthub/
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Independent PostgreSQL 16 instance in agenthub-net.
# Do NOT share with AIhub stack (aihub-hk2 network).
AGENTHUB_DB_HOST=postgres
AGENTHUB_DB_PORT=5432
AGENTHUB_DB_USER=agenthub
# Generate: openssl rand -hex 16
AGENTHUB_DB_PASSWORD=<generate-strong-password>
AGENTHUB_DB_NAME=agenthub

# ── Redis ─────────────────────────────────────
# Independent Redis 7 instance in agenthub-net.
AGENTHUB_REDIS_HOST=redis
AGENTHUB_REDIS_PORT=6379
# Generate: openssl rand -hex 16
AGENTHUB_REDIS_PASSWORD=<generate-strong-password>
AGENTHUB_REDIS_DB=0
AGENTHUB_REDIS_POOL_SIZE=20
AGENTHUB_REDIS_MIN_IDLE_CONNS=2

# ── Container Resource Limits ─────────────────
# hk2 has limited disk (29G root, ~63% used). Keep limits conservative.
# Hub Server ~8.2MiB/256MiB, PG ~22.6MiB/512MiB, Redis ~5.2MiB/384MiB
AGENTHUB_POSTGRES_MEM_LIMIT=512m
AGENTHUB_POSTGRES_CPUS=1.0
AGENTHUB_POSTGRES_PIDS_LIMIT=256
AGENTHUB_REDIS_CONTAINER_MEM_LIMIT=384m
AGENTHUB_REDIS_CPUS=0.5
AGENTHUB_REDIS_PIDS_LIMIT=128
AGENTHUB_HUB_MEM_LIMIT=256m
AGENTHUB_HUB_CPUS=1.0
AGENTHUB_HUB_PIDS_LIMIT=256

# ── JWT Authentication ────────────────────────
# Generate: openssl rand -hex 32 (min 32 chars)
AGENTHUB_JWT_SECRET=<generate-at-least-32-char-secret>
AGENTHUB_JWT_ACCESS_TTL=15m
AGENTHUB_JWT_REFRESH_TTL=720h

# ── Server Configuration ──────────────────────
AGENTHUB_ENV=production
AGENTHUB_SERVER_PORT=8080
AGENTHUB_SERVER_LOG_LEVEL=info
AGENTHUB_SERVER_ADMIN_PORT=6060
AGENTHUB_UPLOAD_DIR=./uploads
AGENTHUB_UPLOAD_MAX_SIZE=10485760

# ── AgentTeam Delegation Guards ───────────────
AGENTHUB_AGENT_TEAM_MAX_DELEGATION_DEPTH=3
AGENTHUB_AGENT_TEAM_MAX_ACTIVE_SUBAGENTS_PER_RUN=5
AGENTHUB_AGENT_TEAM_MAX_ROUTE_REPEATS=3
AGENTHUB_AGENT_TEAM_MAX_TASKS_PER_TEAM_RUN=20
AGENTHUB_AGENT_TEAM_ASSIGNMENT_TIMEOUT=30m
AGENTHUB_AGENT_TEAM_MAX_TEAM_RUN_BUDGET_TOKENS=200000
AGENTHUB_AGENT_TEAM_MAX_TEAM_RUN_BUDGET_USAGE_PCT=95

# ── PPROF Admin Auth (required in production) ─
AGENTHUB_PPROF_USER=admin
# Generate: openssl rand -hex 12
AGENTHUB_PPROF_PASS=<generate-strong-password>

# ── CORS ──────────────────────────────────────
# Tauri Desktop uses origin https://tauri.localhost
AGENTHUB_CORS_ORIGINS=https://hub.vectorcontrol.tech,https://tauri.localhost

# ── S3 Compatible Storage (optional) ──────────
# When configured, file uploads go to S3 instead of local volume.
# Uses vc-storage on hk1 (s3.vectorcontrol.tech) if enabled.
# AGENTHUB_S3_ENDPOINT=https://s3.vectorcontrol.tech
# AGENTHUB_S3_ACCESS_KEY=<access-key>
# AGENTHUB_S3_SECRET_KEY=<secret-key>
# AGENTHUB_S3_BUCKET=agenthub-attachments
# AGENTHUB_S3_REGION=default
# AGENTHUB_S3_USE_SSL=true

# ── TokenDance ID OIDC ────────────────────────
# Register/retrieve from TokenDance ID admin panel at:
#   https://id.tokendancelab.com
# Production Web callback; Desktop uses http://127.0.0.1/callback loopback.
# AGENTHUB_TOKENDANCE_ID_ISSUER_URL=https://id.tokendancelab.com
# AGENTHUB_TOKENDANCE_ID_JWKS_URI=
# AGENTHUB_TOKENDANCE_ID_CLIENT_ID=<your-client-id>
# AGENTHUB_TOKENDANCE_ID_CLIENT_SECRET=<your-client-secret>
# AGENTHUB_TOKENDANCE_ID_REDIRECT_URI=https://hub.vectorcontrol.tech/auth/tokendance/callback
# AGENTHUB_TOKENDANCE_ID_ALLOWED_REDIRECT_URIS=https://hub.vectorcontrol.tech/auth/tokendance/callback,http://127.0.0.1/callback

# ── Hub Image ─────────────────────────────────
# Pre-built image tag. Build on dev/CI machine, docker load on hk2.
# pull_policy: never ensures only pre-loaded images are used.
# AGENTHUB_HUB_IMAGE=ghcr.io/tokendancelab/agenthub-hub:<commit-sha>
