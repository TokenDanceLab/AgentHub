# AgentHub Hub Server — 生产环境变量模板 (production)
# 复制为 .env.production 并填入真实值
# cp .env.production.example .env.production

# ── 数据库（独立 PostgreSQL 实例，不与 AIhub 共用）──
AGENTHUB_DB_HOST=postgres
AGENTHUB_DB_PORT=5432
AGENTHUB_DB_USER=agenthub
AGENTHUB_DB_PASSWORD=<生成强密码>
AGENTHUB_DB_NAME=agenthub

# ── Redis（独立 Redis 实例，不与 AIhub 共用）───────
AGENTHUB_REDIS_HOST=redis
AGENTHUB_REDIS_PORT=6379
AGENTHUB_REDIS_PASSWORD=<生成强密码>
AGENTHUB_REDIS_DB=0
AGENTHUB_REDIS_POOL_SIZE=20
AGENTHUB_REDIS_MIN_IDLE_CONNS=2

# ── 容器资源护栏（生产服务器只加载镜像，不在服务器 build）──
AGENTHUB_POSTGRES_MEM_LIMIT=512m
AGENTHUB_POSTGRES_CPUS=1.0
AGENTHUB_POSTGRES_PIDS_LIMIT=256
AGENTHUB_REDIS_CONTAINER_MEM_LIMIT=384m
AGENTHUB_REDIS_CPUS=0.5
AGENTHUB_REDIS_PIDS_LIMIT=128
AGENTHUB_HUB_MEM_LIMIT=256m
AGENTHUB_HUB_CPUS=1.0
AGENTHUB_HUB_PIDS_LIMIT=256

# ── JWT 认证 ─────────────────────────────────────
AGENTHUB_JWT_SECRET=<生成至少32字符的随机密钥>
AGENTHUB_JWT_ACCESS_TTL=15m
AGENTHUB_JWT_REFRESH_TTL=720h

# ── 服务配置 ─────────────────────────────────────
AGENTHUB_ENV=production
AGENTHUB_SERVER_PORT=8080
AGENTHUB_SERVER_LOG_LEVEL=info
AGENTHUB_SERVER_ADMIN_PORT=6060
AGENTHUB_UPLOAD_DIR=./uploads
AGENTHUB_UPLOAD_MAX_SIZE=10485760

# ── AgentTeam 委派资源护栏 ─────────────────────
AGENTHUB_AGENT_TEAM_MAX_DELEGATION_DEPTH=3
AGENTHUB_AGENT_TEAM_MAX_ACTIVE_SUBAGENTS_PER_RUN=5
AGENTHUB_AGENT_TEAM_MAX_ROUTE_REPEATS=3
AGENTHUB_AGENT_TEAM_MAX_TASKS_PER_TEAM_RUN=20
AGENTHUB_AGENT_TEAM_ASSIGNMENT_TIMEOUT=30m
AGENTHUB_AGENT_TEAM_MAX_TEAM_RUN_BUDGET_TOKENS=200000
AGENTHUB_AGENT_TEAM_MAX_TEAM_RUN_BUDGET_USAGE_PCT=95

# ── PPROF 管理认证（生产必须设置）─────────────────
AGENTHUB_PPROF_USER=admin
AGENTHUB_PPROF_PASS=<生成强密码>

# ── CORS ─────────────────────────────────────────
AGENTHUB_CORS_ORIGINS=https://hub.vectorcontrol.tech

# ── S3 兼容对象存储（可选，未配置时回退到本地 UPLOAD_DIR）──
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=agenthub-attachments
# S3_REGION=us-east-1
# S3_USE_SSL=true

# ── TokenDance ID OIDC — uncomment and fill in real values from TokenDance ID admin panel ──
# AGENTHUB_TOKENDANCE_ID_ISSUER_URL=https://id.vectorcontrol.tech
# AGENTHUB_TOKENDANCE_ID_JWKS_URI=
# AGENTHUB_TOKENDANCE_ID_CLIENT_ID=<your-client-id>
# AGENTHUB_TOKENDANCE_ID_CLIENT_SECRET=<your-client-secret>
# AGENTHUB_TOKENDANCE_ID_REDIRECT_URI=https://hub.vectorcontrol.tech/client/auth/oidc/callback
# AGENTHUB_TOKENDANCE_ID_ALLOWED_REDIRECT_URIS=https://hub.vectorcontrol.tech/auth/tokendance/callback,http://127.0.0.1/callback
