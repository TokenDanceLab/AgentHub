{
  "mode": "approved-real",
  "artifact_root": ".tmp/approved-real-preflight/missing-approval",
  "redaction_policy": {
    "stdout": "redact all sensitive values",
    "stderr": "redact all sensitive values",
    "env": "env var names only",
    "artifacts": "redacted copies only"
  },
  "timeouts": {
    "total_seconds": 900,
    "per_step_seconds": 120,
    "kill_policy": "kill process tree"
  },
  "budget": {
    "max_usd": 2,
    "max_requests": 3,
    "stop_policy": "stop on unexpected spend"
  },
  "target_runtime": {
    "id": "codex",
    "kind": "cli"
  },
  "cli": {
    "command_path": "operator-owned-codex-path",
    "command_plan": "codex exec --json"
  },
  "urls": {
    "hub": "http://127.0.0.1:18080",
    "web": "http://127.0.0.1:5173",
    "desktop": "tauri://localhost",
    "edge": "http://127.0.0.1:8765"
  },
  "test_identifiers": {
    "account_id": "disposable-test-account-identifier",
    "client_id": "tokendance-id-test-client-identifier",
    "target_id": "desktop-target-operator-approved"
  }
}
