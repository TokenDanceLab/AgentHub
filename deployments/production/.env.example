# AgentHub 生产环境变量
# 复制为 .env.production 并填入真实值

# ── PostgreSQL（local PG16, 127.0.0.1:5433; live facts in private deploy repo）──
# 密码（必填）
PG_PASSWORD=change-me-production
# 可选覆盖（defaults align with live; usually no need to set）
# PG_HOST：host-only, no port! DBConfig.DSN() does not split host:port.
# PG_HOST=127.0.0.1
# PG_PORT=5433
# PG_USER=agenthub
# PG_DB_NAME=agenthub
# PG_SSLMODE=disable

# JWT 签名密钥（必填，至少 32 字符的随机字符串）
# 占位符：从环境变量注入，不硬编码示例值（change-me-production* 前缀已被
# config_validate.go 弱密钥 blocklist 拒绝）。
AGENTHUB_JWT_SECRET=${AGENTHUB_JWT_SECRET}

# Security hardening (2026-08-10, CI7)：
# - AUTH_FAIL_CLOSED=true: Redis 故障期间 access-token jti 黑名单检查 fail-closed，
#   防止已登出（吊销）的 access JWT 在 Redis 中断时复活。
# - RATE_LIMIT_FAIL_OPEN=false: 非认证限流器同样 fail-closed（认证路径始终 fail-closed）。
AGENTHUB_AUTH_FAIL_CLOSED=true
AGENTHUB_RATE_LIMIT_FAIL_OPEN=false

# 可选覆盖
# AGENTHUB_JWT_ACCESS_TTL=15m
# AGENTHUB_JWT_REFRESH_TTL=720h
# AGENTHUB_SERVER_LOG_LEVEL=info
# AGENTHUB_TOKENDANCE_ID_CLIENT_ID=
# AGENTHUB_TOKENDANCE_ID_CLIENT_SECRET=

# ── TokenDance ID OIDC（see docker-compose.yml for field definitions）──
# Callback set (issue #1651/#1656; TDID oauth_clients.redirect_uris must match):
#   https://hub.vectorcontrol.tech/api/auth/callback                  → SPA callback (nginx /api/auth/ → :3001)
#   https://hub.vectorcontrol.tech/workbench/auth/tokendance/callback → workbench app/web (BASE_URL=/workbench/)
#   http://127.0.0.1/callback                                         → desktop Tauri loopback (RFC 8252 port-tolerant)
# Hub-side code exchange: POST /client/auth/oidc/callback (desktop/web/CLI shared, not browser redirect).
# Machine-side code exchange (hub-server → TDID /oidc/token) and JWKS fetch
# may use a DNS-only endpoint if the public issuer blocks non-JS clients.
# OIDC client registration and secret managed by TokenDance ID; never commit to repo.
