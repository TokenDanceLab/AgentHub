# AgentHub 生产环境变量
# 复制为 .env.production 并填入真实值

# ── PostgreSQL（hk3 本地 PG16，127.0.0.1:5433；live 事实见 server projects/agenthub/STATE.md）──
# 密码（必填）
PG_PASSWORD=change-me-production
# 可选覆盖（默认与 live 对齐，通常无需设置）
# PG_HOST：只写主机名/IP，不带端口！DBConfig.DSN() 不拆分 host:port，
# 带端口会拼成 host=127.0.0.1:5433 port=5433 连不上。端口走 PG_PORT。
# PG_HOST=127.0.0.1
# PG_PORT=5433
# PG_USER=agenthub
# PG_DB_NAME=agenthub
# PG_SSLMODE=disable

# JWT 签名密钥（必填，至少 32 字符的随机字符串）
# 占位符：从环境变量注入，不硬编码示例值（change-me-production* 前缀已被
# config_validate.go 弱密钥 blocklist 拒绝）。
AGENTHUB_JWT_SECRET=${AGENTHUB_JWT_SECRET}

# Security hardening (2026-08-10, CI7)：
# - AUTH_FAIL_CLOSED=true: Redis 故障期间 access-token jti 黑名单检查 fail-closed，
#   防止已登出（吊销）的 access JWT 在 Redis 中断时复活。
# - RATE_LIMIT_FAIL_OPEN=false: 非认证限流器同样 fail-closed（认证路径始终 fail-closed）。
AGENTHUB_AUTH_FAIL_CLOSED=true
AGENTHUB_RATE_LIMIT_FAIL_OPEN=false

# 可选覆盖
# AGENTHUB_JWT_ACCESS_TTL=15m
# AGENTHUB_JWT_REFRESH_TTL=720h
# AGENTHUB_SERVER_LOG_LEVEL=info
# AGENTHUB_TOKENDANCE_ID_CLIENT_ID=
# AGENTHUB_TOKENDANCE_ID_CLIENT_SECRET=

# ── TokenDance ID OIDC 说明（字段定义见 docker-compose.yml 同目录）──
# 回调集合（2026-08-08 live 实测对齐，issue #1651/#1656；TDID oauth_clients.redirect_uris 必须同步）：
#   https://hub.tokendancelab.com/api/auth/callback                     → 首页 SPA 回调页（nginx /api/auth/ → :3001）
#   https://hub.tokendancelab.com/workbench/auth/tokendance/callback    → 工作台 app/web（BASE_URL=/workbench/）
#   http://127.0.0.1/callback                                           → 桌面 Tauri loopback（RFC 8252 端口宽松匹配）
# Hub 侧代码交换端点固定为 POST /client/auth/oidc/callback（桌面/Web/CLI 共用，非浏览器回跳地址）。
# 机器侧 code 交换（hub-server → TDID /oidc/token）与 JWKS 拉取走 DNS-only 的
# id-token.tokendancelab.com（公网 id 域有 Bot Fight 挑战，拦非 JS 客户端）。
# OIDC client 注册与 secret 由 TokenDance ID 管理，禁止写入仓库。
