# AgentHub 生产环境变量
# 复制为 .env.production 并填入真实值

# ── PostgreSQL（hk3 本地 PG16，127.0.0.1:5433；live 事实见 server projects/agenthub/STATE.md）──
# 密码（必填）
PG_PASSWORD=change-me-production
# 可选覆盖（默认与 live 对齐，通常无需设置）
# PG_HOST=127.0.0.1:5433
# PG_PORT=5433
# PG_USER=agenthub
# PG_DB_NAME=agenthub
# PG_SSLMODE=disable

# JWT 签名密钥（必填，至少 32 字符的随机字符串）
AGENTHUB_JWT_SECRET=change-me-production-min-length-32-chars

# 可选覆盖
# AGENTHUB_JWT_ACCESS_TTL=15m
# AGENTHUB_JWT_REFRESH_TTL=720h
# AGENTHUB_SERVER_LOG_LEVEL=info
# AGENTHUB_TOKENDANCE_ID_CLIENT_ID=
# AGENTHUB_TOKENDANCE_ID_CLIENT_SECRET=

# ── TokenDance ID OIDC 说明（字段定义见 docker-compose.yml 同目录）──
# 生产 OAuth 回调为公网 Web 浏览器回调（canonical，issue #1651）：
#   https://hub.tokendancelab.com/client/auth/oidc/callback
# Hub 在 Web/Desktop 提交 code、state、PKCE verifier、device 与 redirect_uri 后，
# 通过 POST /client/auth/oidc/callback 完成代码交换（Hub 侧交换端点）。
# http://127.0.0.1/callback 仅保留给 Desktop/native 动态 loopback 端口；
# 生产 compose 的 ALLOWED_REDIRECT_URIS 固定为 Web 回调，不放 loopback。
# OIDC client 注册与 secret 由 TokenDance ID 管理，禁止写入仓库。
