# deployments/production — 生产部署环境变量占位模板
#
# 复制为 .env 使用（docker compose 会自动读取）。值全部占位，真实值在
# 凭据由部署环境注入，禁止写入本文件或任何公开位置。
#
# 变量命名空间说明：PG_* 是部署侧变量（避免与宿主机已有 AGENTHUB_*
# 冲突），compose 内部映射为 AGENTHUB_DB_*。OIDC 回调/交换端点说明见
# 根 .env.example 的对应键注释。

# ── 数据库（宿主机 PostgreSQL 16） ─────────────────────────
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=agenthub
PG_PASSWORD=<从部署环境获取>
PG_DB_NAME=agenthub
PG_SSLMODE=require

# ── JWT ──────────────────────────────────────────────────
AGENTHUB_JWT_SECRET=<从部署环境获取>
AGENTHUB_JWT_ACCESS_TTL=15m
AGENTHUB_JWT_REFRESH_TTL=720h

# ── 服务 ─────────────────────────────────────────────────
AGENTHUB_LOG_LEVEL=info
# 部署环境标签：production 启用生产 guard，要求 PG_SSLMODE 非 disable。
AGENTHUB_ENV=production
# CORS 白名单（逗号分隔）；留空使用内置默认。
# AGENTHUB_CORS_ORIGINS=

# ── OIDC（TokenDance ID 生产 OAuth client 注册后填写）──────
# 注册方式与端点语义见 hub-server/scripts/setup-tokendance-oidc.sh
AGENTHUB_TOKENDANCE_ID_ISSUER_URL=
AGENTHUB_TOKENDANCE_ID_CLIENT_ID=
AGENTHUB_TOKENDANCE_ID_CLIENT_SECRET=
AGENTHUB_TOKENDANCE_ID_REDIRECT_URI=
AGENTHUB_TOKENDANCE_ID_ALLOWED_REDIRECT_URIS=
