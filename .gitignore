# =============================================================================
# Docs & Local Files
# =============================================================================
# Competition docs: keep sanitized Markdown evidence tracked; generated/private
# screenshots, recordings, exports, and submission bundles stay ignored by the
# artifact/media rules above and by the scoped rules below.
docs/competition/*
!docs/competition/
!docs/competition/**/
!docs/competition/**/*.md
docs/competition/**/artifacts/
docs/competition/**/exports/
docs/competition/**/screenshots/
docs/competition/**/videos/
docs/competitive-gap/
docs/COMPETITIVE-GAP.md

# Agent inbox — reports dropped by other agents, local only
docs/inbox/*
!docs/inbox/README.md

# Review reports — cross-review and audit outputs
docs/review/*
!docs/review/README.md

# Local dev tracking (not for repo)
docs/GOAL.md

# Local ops docs — deployment details, SSH, server addresses (not for repo)
.ops/

# Cloned reference repos (at repo root only)
/reference/*
!/reference/INDEX.md
/chat-verify/

# =============================================================================
# Generated Files & Compiler Output
# =============================================================================
**/tsc-output.txt
app/desktop/stats.html
.handoff.md
